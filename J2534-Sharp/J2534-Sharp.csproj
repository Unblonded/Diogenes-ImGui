<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <RootNamespace>J2534_Sharp</RootNamespace>
  </PropertyGroup>

  <!-- x86 only on Windows, where the drivers are 32-bit; Mac and Linux drivers match the machine (arm64 on M chips) -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU' And $([MSBuild]::IsOSPlatform('Windows'))">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
